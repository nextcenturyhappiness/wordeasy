{
  "name": "article-english",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode demo",
    "dev:demo": "vite --mode demo",
    "dev:cloud": "vite --mode production",
    "build": "npm run typecheck && vite build",
    "build:preview": "npm run typecheck && vite build --mode preview --outDir dist-preview",
    "preview": "vite preview",
    "preview:local": "vite preview --outDir dist-preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:app && npm run typecheck:edge",
    "typecheck:app": "tsc -b",
    "typecheck:edge": "tsc -p supabase/functions/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/data tests/scheduler tests/sync",
    "test:component": "vitest run tests/ui",
    "test:integration": "vitest run tests/integration",
    "test:content": "vitest run tests/content",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:pwa": "node scripts/check-pwa.mjs",
    "test:pwa:preview": "node scripts/check-pwa.mjs dist-preview",
    "test:preview-build": "node scripts/check-preview-build.mjs",
    "test:preview:e2e": "playwright test --config playwright.preview.config.ts",
    "test:pwa:offline": "node scripts/run-pwa-offline-e2e.mjs",
    "test:pwa:offline:app-shell": "playwright test --config playwright.pwa.config.ts",
    "test:pwa:offline:learning": "playwright test --config playwright.pwa-learning.config.ts",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:perf": "vitest run tests/performance",
    "test:perf:e2e": "node scripts/run-performance-e2e.mjs",
    "test:perf:e2e:run": "playwright test --config playwright.performance.config.ts",
    "test:perf:cloud-run": "playwright test --config playwright.cloud-performance.config.ts",
    "test:secrets": "node scripts/check-secrets.mjs",
    "build:performance-fixture": "tsc -b && vite build --mode performance",
    "build:cloud-performance-fixture": "tsc -b && vite build --mode cloud-performance",
    "content:validate": "node scripts/validate-content.mjs",
    "content:seed-sql": "node scripts/generate-seed-sql.mjs",
    "content:seed-sql:check": "node scripts/generate-seed-sql.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "dexie": "4.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "ts-fsrs": "5.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
