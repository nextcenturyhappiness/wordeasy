{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "wordeasy",
  "version": "0.1.0",
  "identifier": "com.nextcenturyhappiness.wordeasy",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:desktop:web",
    "beforeBuildCommand": "npm run build:desktop:web",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wordeasy",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": [],
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "csp": "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'none'; img-src 'self'; font-src 'self'; connect-src 'self' https://kksllqgtjtfxfnknlrfn.supabase.co wss://kksllqgtjtfxfnknlrfn.supabase.co; worker-src 'none'; manifest-src 'none'; media-src 'none'; frame-src 'none'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Content-Type-Options": "nosniff"
      }
    },
    "withGlobalTauri": false,
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Research and Medical English in context",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  }
}
